{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    },
    "api/admin/[action].js": {
      "maxDuration": 60,
      "includeFiles": "src/data/{swrtPlayersIndex,swrtGuardianMeta,allMonsters,monsterSkillsData,allMdcData,balancePatchAi,swrtPlayerSummaries,swrtRankCutoffs}.json"
    }
  }
}
