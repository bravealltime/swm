# Cloudflare R2 Public CDN URL (Can be https://pub-xxxxxx.r2.dev or custom domain e.g. https://assets.swm.gg)
VITE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Cloudflare R2 API Credentials (Used by scripts/syncToR2.js for uploading & syncing)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=swm-assets
