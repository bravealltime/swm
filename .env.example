# Summoners War Master (SWM) - Environment Variables
# Copy this file to .env and fill in your Supabase credentials (from https://supabase.com)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI provider (OpenAI-compatible chat/completions). Server-side only.
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=model-name
AI_API_KEY=your-secret-key

# --- back-office (/admin) ---
# Emails allowed into the back-office (comma separated). Users log in with Supabase first.
ADMIN_EMAILS=you@example.com
# Optional: lets the back-office start GitHub Actions and show run history.
# Fine-grained token for this repo with "Actions: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=bravealltime/swm
# Local development only (ignored on Vercel): open /admin without logging in
# ADMIN_DEV_BYPASS=1
