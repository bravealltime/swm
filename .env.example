# Summoners War Master (SWM) - Environment Variables
# Copy this file to .env and fill in your Supabase credentials (from https://supabase.com)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI provider (OpenAI-compatible chat/completions). Server-side only.
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=model-name
AI_API_KEY=your-secret-key
